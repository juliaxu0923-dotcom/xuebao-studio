# Copy to .env and set the environment variables before public launch.
ADMIN_USERNAME=admin
# IMPORTANT: At least 12 chars. If blank, a random password is saved under data/admin-initial-password.txt.
ADMIN_PASSWORD=
ALLOW_SIGNUP=1
NEW_USER_POINTS=100
# In production behind HTTPS, set COOKIE_SECURE=1
COOKIE_SECURE=0
# Only for a trusted self-hosted local API, never enable for open hosted SaaS without egress controls.
ALLOW_HTTP_PROVIDERS=0
ALLOW_PRIVATE_PROVIDER_URLS=0
