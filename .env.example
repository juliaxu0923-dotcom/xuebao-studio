STUDIO_PORT=8000
ADMIN_USERNAME=admin
# Blank generates a random initial password in the private data volume.
ADMIN_PASSWORD=
ALLOW_SIGNUP=1
# Use 0 for HTTP by IP, then 1 after configuring HTTPS for a domain.
COOKIE_SECURE=0
# Optional outbound proxy shared by Jimeng API requests and QR login browser.
JIMENG2API_HTTP_PROXY=
